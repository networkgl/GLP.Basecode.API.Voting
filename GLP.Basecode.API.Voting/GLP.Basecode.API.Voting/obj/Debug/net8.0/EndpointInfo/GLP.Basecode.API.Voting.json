{
  "openapi": "3.0.1",
  "info": {
    "title": "GLP Voting System Backend API",
    "version": "v1"
  },
  "paths": {
    "/api/account/login": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginViewInputModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginViewInputModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginViewInputModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/account/get-all-roles": {
      "get": {
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/account/create": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountViewInputModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountViewInputModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountViewInputModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/account/recovery/send-otp": {
      "post": {
        "tags": [
          "Account"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordViewInputModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordViewInputModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordViewInputModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/candidate/{id}": {
      "get": {
        "tags": [
          "Candidate"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/candidate/create": {
      "post": {
        "tags": [
          "Candidate"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "CandidateImage",
                  "PartyListId",
                  "PositionId",
                  "StudentId"
                ],
                "type": "object",
                "properties": {
                  "CandidateImage": {
                    "type": "string",
                    "format": "binary"
                  },
                  "StudentId": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "PartyListId": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "PositionId": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              },
              "encoding": {
                "CandidateImage": {
                  "style": "form"
                },
                "StudentId": {
                  "style": "form"
                },
                "PartyListId": {
                  "style": "form"
                },
                "PositionId": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/partylist/{id}": {
      "get": {
        "tags": [
          "PartyList"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/partylist/create": {
      "post": {
        "tags": [
          "PartyList"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "PartyListImage",
                  "PartyListName"
                ],
                "type": "object",
                "properties": {
                  "PartyListName": {
                    "type": "string"
                  },
                  "PartyListImage": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "PartyListName": {
                  "style": "form"
                },
                "PartyListImage": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/partylist/update/{id}": {
      "put": {
        "tags": [
          "PartyList"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "PartyListName": {
                    "type": "string"
                  },
                  "PartyListImage": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "PartyListName": {
                  "style": "form"
                },
                "PartyListImage": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountViewInputModel": {
        "required": [
          "courseId",
          "firstName",
          "idNumber",
          "lastName",
          "syId",
          "userEmail"
        ],
        "type": "object",
        "properties": {
          "idNumber": {
            "maximum": 99999999,
            "minimum": 10000000,
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "minLength": 1,
            "type": "string"
          },
          "middleName": {
            "type": "string",
            "nullable": true
          },
          "courseId": {
            "type": "integer",
            "format": "int64"
          },
          "syId": {
            "type": "integer",
            "format": "int64"
          },
          "userEmail": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ForgotPasswordViewInputModel": {
        "required": [
          "userEmail"
        ],
        "type": "object",
        "properties": {
          "userEmail": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginViewInputModel": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter JWT Bearer token only (without 'Bearer' prefix).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}